
import React, { useState } from 'react';

const Display = ({ value }) => (
  <div style={{ backgroundColor: '#ccc', padding: '20px', textAlign: 'right', fontSize: '24px', minHeight: '30px' }}>
    {value || '0'}
  </div>
);

const Button = ({ label, color, span, onClick }) => (
  <button
    onClick={() => onClick(label)}
    style={{
      backgroundColor: color || '#4CAF50', 
      border: '1px solid #333', 
      padding: '15px', 
      fontSize: '18px', 
      cursor: 'pointer',
      gridColumn: span ? `span ${span}` : 'auto'
    }}
  >
    {label}
  </button>
);

export function Calculator() {
  const [expression, setExpression] = useState('');

  const handleAction = (label) => {
    if (label === 'Clear') setExpression('');
    else if (label === 'Delete') setExpression((prev) => prev.slice(0, -1));
    else if (label === '=') {
      try {
        setExpression(String(new Function('return ' + expression)()));
      } catch {
        setExpression('Error');
      }
    } else {
      if (expression === 'Error') setExpression(label);
      else setExpression((prev) => prev + label);
    }
  };

  const buttons = [
    { label: 'Clear', color: '#5cb85c' }, { label: 'Delete', color: '#5cb85c' }, { label: '.', color: '#5cb85c' }, { label: '/', color: '#5cb85c' },
    { label: '7', color: '#5cb85c' }, { label: '8', color: '#5cb85c' }, { label: '9', color: '#5cb85c' }, { label: '*', color: '#5cb85c' },
    { label: '4', color: '#5cb85c' }, { label: '5', color: '#5cb85c' }, { label: '6', color: '#5cb85c' }, { label: '-', color: '#5cb85c' },
    { label: '1', color: '#5cb85c' }, { label: '2', color: '#5cb85c' }, { label: '3', color: '#5cb85c' }, { label: '+', color: '#5cb85c' },
    { label: '0', color: '#4cae4c', span: 2 }, { label: '=', color: '#4cae4c', span: 2 }
  ];

  return (
    <div style={{ width: '300px', margin: '20px auto', border: '1px solid #333' }}>
      <Display value={expression} />
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)' }}>
        {buttons.map((btn, i) => (
          <Button key={i} label={btn.label} color={btn.color} span={btn.span} onClick={handleAction} />
        ))}
      </div>
    </div>
  );
}
